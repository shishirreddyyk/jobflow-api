{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "JobFlow - API & Jobs",
  "tags": ["jobflow"],
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "templating": { "list": [] },
  "panels": [
    {
      "type": "timeseries",
      "title": "API request rate (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total[1m]))", "legendFormat": "requests/s" }
      ]
    },
    {
      "type": "timeseries",
      "title": "API latency p95 (s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Job throughput by status (jobs/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(jobflow_jobs_finished_total[1m])) by (status)", "legendFormat": "{{status}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Job duration p95 by task (s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum(rate(jobflow_job_duration_seconds_bucket[5m])) by (le, task_type))", "legendFormat": "{{task_type}}" }
      ]
    },
    {
      "type": "stat",
      "title": "Jobs in progress",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "targets": [ { "refId": "A", "expr": "jobflow_jobs_in_progress" } ]
    },
    {
      "type": "stat",
      "title": "Jobs submitted (total)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "targets": [ { "refId": "A", "expr": "sum(jobflow_jobs_submitted_total)" } ]
    },
    {
      "type": "stat",
      "title": "Failed jobs (total)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "targets": [ { "refId": "A", "expr": "sum(jobflow_jobs_finished_total{status=\"failed\"})" } ]
    }
  ]
}
